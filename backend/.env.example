# --- Core ---
APP_ENV=development
DATABASE_URL=sqlite:///./signalhunter.db
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# --- LLM provider (optional; system works without keys using deterministic engine) ---
# LLM_PROVIDER=none | openai_compatible
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- Web search provider (optional; built-in keyless provider works out of the box) ---
# SEARCH_PROVIDER=builtin | serper | tavily
SEARCH_PROVIDER=builtin
SERPER_API_KEY=
TAVILY_API_KEY=
# --- Job system (optional Redis; default is in-process asyncio) ---
REDIS_URL=
# --- Fetch policy ---
FETCH_TIMEOUT_S=25
FETCH_MAX_BYTES=6000000
FETCH_MAX_PAGES_PER_INVESTIGATION=24
